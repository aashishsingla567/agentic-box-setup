# Copy to .env and fill in. .env is gitignored — secrets never enter git.
# Every variable here is OPTIONAL. Anything unset is simply skipped
# (provider CLIs fall back to their normal interactive logins).

# Tailscale: lets `tailscale up` join your tailnet with zero interaction.
# Create at https://login.tailscale.com/admin/settings/keys (reusable, ephemeral).
TAILSCALE_AUTHKEY=

# Optional: non-interactive/provider defaults. Only set what you need.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional secret only. Copy to .env and chmod 600 .env; never commit it.
# Parsed as data, never sourced. Use JSON/--set for all nonsecret settings.
# Joining also requires network.join=true. Existing Running identities are retained.
# Scope an auth key to the intended tailnet/device policy; it is not needed for OIDC.
TAILSCALE_AUTHKEY=
